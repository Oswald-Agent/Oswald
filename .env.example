# OSWALD Environment Configuration

# Anthropic API Key (required for agent LLM calls)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# PostgreSQL Database URL
DATABASE_URL=postgresql+asyncpg://oswald:oswald@localhost:5432/oswald

# Redis URL (job queue and ephemeral cache)
REDIS_URL=redis://localhost:6379/0

# Structured Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
