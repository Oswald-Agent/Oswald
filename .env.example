# OSWALD Environment Configuration

# Universal LLM Provider API Key (Google AI Studio, Anthropic, OpenAI, etc.)
LLM_PROVIDER_KEY=your-llm-provider-key-here

# Optional: Custom API Base URL (for local models or proxy)
# LLM_BASE_URL=http://localhost:11434/v1

# Agent Model Configurations (LiteLLM format: gemini/gemini-2.0-flash, gpt-4o, claude-3-5-sonnet-20241022)
DEFAULT_MODEL=gemini/gemini-2.0-flash
PLANNER_MODEL=gemini/gemini-2.0-flash
CODER_MODEL=gemini/gemini-2.0-flash
TESTER_MODEL=gemini/gemini-2.0-flash
REVIEWER_MODEL=gemini/gemini-2.0-flash

# PostgreSQL Database URL
DATABASE_URL=postgresql+asyncpg://oswald:oswald@localhost:5432/oswald

# Redis URL (job queue and ephemeral cache)
REDIS_URL=redis://localhost:6379/0

# Structured Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
